# Copie para .env (não commitado) e preencha antes de rodar
# `docker compose up` neste diretório.

POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Opcional — se definido, o processor passa a exigir o header
# "X-API-Key" com este valor em POST /candles e nos endpoints de
# escrita da watchlist. Se deixar vazio, a checagem é pulada (o
# processor não deve, de qualquer forma, ficar exposto fora da
# rede/tailnet do homelab).
PROCESSOR_API_KEY=
